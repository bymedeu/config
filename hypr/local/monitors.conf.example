################
### MONITORS ###
################

# Machine-specific layout. Copy this file to monitors.conf (gitignored)
# and uncomment or edit the blocks you need.
# See https://wiki.hyprland.org/Configuring/Monitors/

# Laptop panel
# monitorv2 {
#     output = eDP-1
#     mode = preferred
#     position = 0x0
#     scale = 1
# }

# External display by description (replace with `hyprctl monitors`)
# monitorv2 {
#     output = desc:Make Model Serial
#     mode = 1920x1080@60
#     position = -1920x0
#     scale = 1
# }

# Everything else
monitorv2 {
    output = *
    mode = preferred
    position = auto
    scale = auto
}
