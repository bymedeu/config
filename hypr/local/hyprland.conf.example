# Machine-specific Hyprland overlay. Copy this file to hyprland.conf
# (gitignored) so Hyprland always has a source target.
#
# Default: portable fallback. Uncomment monitors.conf after copying
# monitors.conf.example if this machine needs a custom layout.

source = ~/.config/hypr/config/monitors/default.conf
# source = ~/.config/hypr/local/monitors.conf
