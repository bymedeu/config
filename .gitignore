!/git/hooks/pre-rebase
!/git/hooks/pre-receive
!/git/hooks/prepare-commit-msg
!/git/hooks/proc-receive
!/git/hooks/push-to-checkout
!/git/hooks/reference-transaction
!/git/hooks/sendemail-validate
!/git/hooks/update

**/__pycache__/
*.pyc
