# Deny-by-default: only allowlisted trees are public.
# Anything a new app dumps into ~/.config stays untracked.
#
# Un-ignore directory names with no trailing slash so Git treats both
# real directories and (during migration) symlink names as allowlisted.

/*

!/.gitignore
!/README.md

!/nvim
!/nvim/**

!/zsh
!/zsh/**

!/clang
!/clang/**

!/hypr
!/hypr/**

!/kitty
!/kitty/**

!/waybar
!/waybar/**

!/rofi
!/rofi/**

!/swaync
!/swaync/**

!/fnott
!/fnott/**

!/fastfetch
!/fastfetch/**

!/scripts
!/scripts/**

!/htop
!/htop/**

!/colors
!/colors/**

!/vscode
!/vscode/**

!/electron-flags.conf
!/codium-flags.conf

# Nvim runtime
nvim/nvim.log
nvim/*.log

# Zsh machine overlay and secrets
zsh/private_*.zsh

# Hyprland machine overlay, photos, and runtime state
hypr/local/monitors.lua
hypr/local/hyprland.lua
hypr/assets/*
!hypr/assets/README.md
!hypr/assets/.gitkeep
hypr/images/*
!hypr/images/README.md
hypr/status/
hypr/config/monitors/perso.lua
hypr/config/monitors.lua
hypr/monitors.lua
hypr/application-style.lua
hypr/workspaces.lua

# Fastfetch local logo and leftover copies
fastfetch/logo.png
fastfetch/old.jsonc

# Editor / notification backups
swaync/*.old

# Local process-viewer history
htop/htop_history

!/albert/
/albert/**
!/albert/
!/albert/config
!/albert/
!/albert/websearch/
!/albert/websearch/engines.json
!/albert/
!/albert/schemes/
!/albert/schemes/Seventy Eight.qss
!/albert/
!/albert/themes/
!/albert/themes/Waybar.ini

!/gtk-3.0/
/gtk-3.0/**
!/gtk-3.0/
!/gtk-3.0/settings.ini

!/cosmic/
/cosmic/**
!/cosmic/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/bg_color
!/cosmic/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/accent
!/cosmic/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/spacing
!/cosmic/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/gaps
!/cosmic/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/active_hint
!/cosmic/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/
!/cosmic/com.system76.CosmicTheme.Dark.Builder/v1/corner_radii
!/cosmic/
!/cosmic/com.system76.CosmicTheme.Mode/
!/cosmic/com.system76.CosmicTheme.Mode/v1/
!/cosmic/com.system76.CosmicTheme.Mode/v1/is_dark

!/vim/
/vim/**
!/vim/
!/vim/vimrc
!/scripts/
!/scripts/bin/
!/scripts/bin/avahi-patch.sh
!/scripts/
!/scripts/bin/
!/scripts/bin/codium-patch.sh
!/scripts/
!/scripts/bin/
!/scripts/bin/rust-quick-run.sh
!/scripts/
!/scripts/bin/
!/scripts/bin/set-lockscreen
!/scripts/
!/scripts/bin/
!/scripts/bin/set-wallpaper

!/config.json

!/install.py

!/links.json

!/README.md

# Public shared hooks only; Git identity, credentials and runtime stay private.
!/git/
/git/**
!/git/README.md
!/git/cppcheck.py
!/git/default.yaml
!/git/dispatch.py
!/git/format_cpp.py
!/git/git-quality-cppcheck
!/git/git-quality-format
!/git/requirements.txt
!/git/run-hook
!/git/setup.py
!/git/test_hooks.py
!/git/hooks/
!/git/hooks/applypatch-msg
!/git/hooks/commit-msg
!/git/hooks/fsmonitor-watchman
!/git/hooks/p4-changelist
!/git/hooks/p4-post-changelist
!/git/hooks/p4-pre-submit
!/git/hooks/p4-prepare-changelist
!/git/hooks/post-applypatch
